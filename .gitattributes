# Normaliza los finales de línea para que el repositorio sea idéntico en
# Windows, macOS y Linux.
* text=auto eol=lf

*.py     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.csv    text eol=lf

*.png    binary
*.jpg    binary
*.pdf    binary
*.docx   binary
*.xlsx   binary

# El notebook es JSON en disco, así que se trata como texto; el lenguaje se
# declara Python para que las estadísticas del repositorio reflejen el código
# escrito y no el formato del contenedor.
*.ipynb  text eol=lf linguist-language=Python
